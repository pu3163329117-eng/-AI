# Development default is sqlite:///../data/wenyan.db
WENYAN_DATABASE_URL=sqlite:///./data/wenyan.db

# AI settings: copy to backend/.env (ignored by Git), never put a key in frontend.
# Database configuration above remains an OS environment setting, not loaded by AI.
WENYAN_AI_ENABLED=0
WENYAN_AI_DATA_POLICY=synthetic_only
WENYAN_AI_MODEL=deepseek-flash
DEEPSEEK_API_KEY=

# Local collaboration bridge. Keep disabled unless starting it intentionally.
# Set the token only in the process environment; do not commit a real value.
WENYAN_COLLABORATION_ENABLED=0
WENYAN_COLLABORATION_RUNTIME=mock
WENYAN_COLLABORATION_TOKEN=
WENYAN_COLLABORATION_DATABASE_URL=sqlite:///./data/collaboration.db
WENYAN_COLLABORATION_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# Real Harness mode additionally requires a fresh explicit user authorization.
WENYAN_COLLABORATION_REAL_CALLS_ENABLED=0
