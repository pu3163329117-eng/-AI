# Development default is sqlite:///../data/wenyan.db
WENYAN_DATABASE_URL=sqlite:///./data/wenyan.db

# AI settings: copy to backend/.env (ignored by Git), never put a key in frontend.
# Database configuration above remains an OS environment setting, not loaded by AI.
WENYAN_AI_ENABLED=0
WENYAN_AI_DATA_POLICY=synthetic_only
WENYAN_AI_MODEL=deepseek-flash
DEEPSEEK_API_KEY=
